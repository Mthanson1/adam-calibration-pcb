	(text_box "TL431 CLAMP SINK BUDGET (WORST CASE, ALL FAULTS AT ONCE)\nFAULT: +24 V SHORTED ONTO EVERY CLAMPED INPUT\nVf = 0.60 V (1.25 V MAX)\nV_CLAMP(MIN) = V_SHUNT(MIN) + Vf = 3.42 + 0.60 = 4.02 V\n\nPROX CH0/CH1 (R_TOP @{${R_TOP}/1000}k / R_BOT @{${R_BOT}/1000}k + Rs @{${Rs}/1000}k):\n  V_TH = 24*R_BOT/(R_TOP+R_BOT) = @{round(24*${R_BOT}/(${R_TOP}+${R_BOT}),2)} V\n  R_TH + Rs = @{round((${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs})/1000,2)} kΩ\n  I = (V_TH − 4.02)/(R_TH + Rs) = @{round(max(0,(24*${R_BOT}/(${R_TOP}+${R_BOT})-4.02)/(${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs}))*1000,2)} mA EACH\nUART TX (R29 = ${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE} Ω 2512, CONNECTOR SIDE OF CLAMP):\n  DUET OPTO-PORT PULL-UP = 4.7k => V_LOW = @{round(3.3*${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE}/(4700+${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE}),2)} V (< 0.9 V)\n  I = (24 − 4.02)/R29 = @{round((24-4.02)/${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE}*1000,1)} mA,  P(R29) = @{round((24-4.02)*(24-4.02)/${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE},2)} W => 2512 (1 W)\nUART RX (R31 = 4.7k, DRIVEN BY DUET 470 Ω PUSH-PULL):\n  I = (24 − 4.02)/4.7k = 4.25 mA,  P(R31) = 85 mW => 0805 MIN.\nZ_PROBE / OUT_0: 2N7002 OPEN-DRAIN NOT CLAMPED = 0 mA\nLOAD CELL: NOT CLAMPED = 0 mA\n------------------------------------------------\nI_FAULT(MAX) = @{round(2*max(0,(24*${R_BOT}/(${R_TOP}+${R_BOT})-4.02)/(${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs}))*1000+(24-4.02)/${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE}*1000+4.25,1)} mA   (TL431 I_KA(MAX) = 100 mA)\nP_TL431 = 3.58 V*I_FAULT = @{round(3.58*(2*max(0,(24*${R_BOT}/(${R_TOP}+${R_BOT})-4.02)/(${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs}))*1000+(24-4.02)/${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE}*1000+4.25),0)} mW\nP_D13A ≈ 0.9 V*I_TX = @{round(0.9*(24-4.02)/${/01121b40-7bd0-4bf5-ba88-6000dd309313/0ee76a58-5905-43e9-a43a-ac7fd6e43632/1fe91622-a894-40f6-bac4-236cb8803c43:VALUE}*1000,0)} mW (BAV199: 160 mA / 200 mW RATED)\nV_NODE(MAX) = 3.58 + 1.0 (Vf MAX @ 10 mA) = 4.58 V\n3V3 LOAD ABSORBS FAULT CURRENT FIRST; TL431 ONLY\nCONDUCTS WHEN I_FAULT > I_LOAD (E.G. MCU IN RESET)"
		(exclude_from_sim no)
