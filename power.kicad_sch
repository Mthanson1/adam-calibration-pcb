	(text_box "TL431 CLAMP SINK BUDGET (WORST CASE, ALL FAULTS AT ONCE)\nFAULT: +24 V SHORTED ONTO EVERY CLAMPED INPUT\nVf = 0.60 V (LOW-END EST., ~1 mA, HOT → CONSERVATIVE FOR I_FAULT)\nV_CLAMP(MIN) = V_SHUNT(MIN) + Vf = 3.42 + 0.60 = 4.02 V\n\nPROX CH0/CH1 (R_TOP @{${R_TOP}/1000}k / R_BOT @{${R_BOT}/1000}k + Rs @{${Rs}/1000}k):\n  V_TH = 24 × R_BOT/(R_TOP+R_BOT) = @{round(24*${R_BOT}/(${R_TOP}+${R_BOT}),2)} V\n  R_TH + Rs = @{round((${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs})/1000,2)} kΩ\n  I = (V_TH − 4.02)/(R_TH + Rs) = @{round(max(0,(24*${R_BOT}/(${R_TOP}+${R_BOT})-4.02)/(${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs}))*1000,2)} mA EACH\nUART TX/RX (R_IO = 4.7k, CONNECTOR SIDE OF CLAMP):\n  I = (24 − 4.02)/4.7k = 4.25 mA EACH → 8.5 mA\n  P(R_IO) = 85 mW EACH => 0805 MIN.\nZ_PROBE / OUT_0: 2N7002 OPEN-DRAIN NOT CLAMPED = 0 mA\nLOAD CELL: NOT CLAMPED = 0 mA\n------------------------------------------------\nI_FAULT(MAX) = @{round(2*max(0,(24*${R_BOT}/(${R_TOP}+${R_BOT})-4.02)/(${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs}))*1000+8.5,1)} mA   (TL431 I_KA(MAX) = 100 mA)\nP_TL431 = 3.58 V × I_FAULT = @{round(3.58*(2*max(0,(24*${R_BOT}/(${R_TOP}+${R_BOT})-4.02)/(${R_TOP}*${R_BOT}/(${R_TOP}+${R_BOT})+${Rs}))*1000+8.5),0)} mW\nV_NODE(MAX) = 3.58 + 1.0 (Vf MAX @ 10 mA) = 4.58 V\n3V3 LOAD ABSORBS FAULT CURRENT FIRST; TL431 ONLY\nCONDUCTS WHEN I_FAULT > I_LOAD (E.G. MCU IN RESET)"
		(exclude_from_sim no)
		(at 162.56 58.8038 0)
		(size 77.47 42.7962)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dabb1b34-f67f-4938-b499-18e19b6f8167")
	)
